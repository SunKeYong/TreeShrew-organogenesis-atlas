rule make_nonpeaks:
    benchmark:
        "benchmarks/make_nonpeaks/fold_{fold}_{celltype}.tsv"
    input:
        #peaks_no_blacklist=lambda w: f"data/peak_no_blacklist/{w.celltype}_peak_no_blacklist.bed",
        peak=lambda w: f"{config['INPUT_PEAK_DIR']}/{w.celltype}_W1000bp_Peak.modified.bed",
        split=lambda w: f"{config['FOLD_DIR']}/{config['FOLD'][w.fold]}",
        genome=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['GENOME']}",
        chromsize=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['CHROMSIZE']}"
        #blacklist=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['BLACKLIST']}"
    output:
        aux=directory("data/nonpeaks/fold_{fold}/{celltype}_auxiliary"),
        bed="data/nonpeaks/fold_{fold}/{celltype}_negatives.bed"
    params:
        out_dir=lambda w: f"data/nonpeaks/fold_{w.fold}",
        out_prefix=lambda w: f"data/nonpeaks/fold_{w.fold}/{w.celltype}",
        script="./setup_environment.sh"
    shell:
        """
        mkdir -p {params.out_dir}
        {params.script} chrombpnet prep nonpeaks \
        -g {input.genome} \
        -p {input.peak} \
        -c {input.chromsize} \
        -fl {input.split} \
        -o {params.out_prefix}
        """

rule model_train:
    benchmark:
        "benchmarks/model_train/fold_{fold}_{celltype}.tsv"
    threads: 8
    resources:
        mem_mb=64000,
        gpus=1,
        runtime=1440 #24h
    input:
        bed=lambda w: f"{config['INPUT_BED_DIR']}/{w.celltype}.sort.bed",
        #peaks_no_blacklist=lambda w: f"data/peak_no_blacklist/{w.celltype}_peak_no_blacklist.bed",
        peak=lambda w: f"{config['INPUT_PEAK_DIR']}/{w.celltype}_W1000bp_Peak.modified.bed",
        #nonpeak=rules.make_nonpeaks.output.bed,
        nonpeak=lambda w: f"data/nonpeaks/fold_{w.fold}/{w.celltype}_negatives.bed",
        split=lambda w: f"{config['FOLD_DIR']}/{config['FOLD'][w.fold]}",
        bias=config['BIAS_MODEL'],
        genome=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['GENOME']}",
        chromsize=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['CHROMSIZE']}",
        #blacklist=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['BLACKLIST']}"
    output:
        auxiliary=directory("output/models/fold_{fold}/{celltype}/auxiliary"),
        evaluation=directory("output/models/fold_{fold}/{celltype}/evaluation"),
        logs=directory("output/models/fold_{fold}/{celltype}/logs"),
        # using "directory" to prevent snakemake from automatically creating the models/ folder in the beginning which will cause a chrombpnet error
        models=directory("output/models/fold_{fold}/{celltype}/models"), 
        success="output/models/fold_{fold}/{celltype}/success.txt" # adding this to indicate end of process for subsequent rules that depend on this rule since output is a folder here
    params:
        assay="ATAC",
        script="./setup_environment.sh",
        folder=lambda w: f"output/models/fold_{w.fold}/{w.celltype}",
        batchsize=64
    shell:
        """
        mkdir -p {params.folder}; 
        {params.script} chrombpnet pipeline \
        -ifrag {input.bed} \
        -d {params.assay} \
        -g {input.genome} \
        -c {input.chromsize} \
        -p {input.peak} \
        -n {input.nonpeak} \
        -fl {input.split} \
        -b {input.bias} \
        -o {params.folder} \
        -bs {params.batchsize};
        touch {output.success}
        """

rule model_shap:
    benchmark:
        "benchmarks/model_shap/fold_{fold}_{celltype}.tsv"
    threads: 8
    resources:
        mem_mb=150000,
        gpus=1,
        runtime=7200 #5d
    input:
        success=rules.model_train.output.success,
        #peaks_no_blacklist=lambda w: f"data/peak_no_blacklist/{w.celltype}_peak_no_blacklist.bed",
        peak=lambda w: f"{config['INPUT_PEAK_DIR']}/{w.celltype}_W1000bp_Peak.modified.bed",
        genome=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['GENOME']}",
        chromsize=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['CHROMSIZE']}"
    output:
        folder=directory("output/models/fold_{fold}/{celltype}/interpret_counts/"),
        success="output/models/fold_{fold}/{celltype}/.shapsuccess"
    params:
        no_bias_model=lambda w: f"output/models/fold_{w.fold}/{w.celltype}/models/chrombpnet_nobias.h5",
        out_prefix=lambda w: f"output/models/fold_{w.fold}/{w.celltype}/interpret_counts/{w.celltype}",
        script="./setup_environment.sh"
    shell:
        """
        mkdir -p {output.folder};
        {params.script} chrombpnet contribs_bw \
        -m {params.no_bias_model} \
        -r {input.peak} \
        -pc counts \
        -g {input.genome} \
        -c {input.chromsize} \
        -op {params.out_prefix};
        touch {output.success}
        """

rule model_shap_profile:
    benchmark:
        "benchmarks/model_shap_profile/fold_{fold}_{celltype}.tsv"
    threads: 8
    resources:
        mem_mb=150000,
        gpus=1,
        runtime=7200 #5d
    input:
        success=rules.model_train.output.success,
        #peaks_no_blacklist=lambda w: f"data/peak_no_blacklist/{w.celltype}_peak_no_blacklist.bed",
        peak=lambda w: f"{config['INPUT_PEAK_DIR']}/{w.celltype}_W1000bp_Peak.modified.bed",
        genome=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['GENOME']}",
        chromsize=f"{config['RESOURCE_DIR']}/{config['RESOURCE']['CHROMSIZE']}"
    output:
        folder=directory("output/models/fold_{fold}/{celltype}/interpret_profile/"),
        success="output/models/fold_{fold}/{celltype}/.shapprofilesuccess"
    params:
        no_bias_model=lambda w: f"output/models/fold_{w.fold}/{w.celltype}/models/chrombpnet_nobias.h5",
        out_prefix=lambda w: f"output/models/fold_{w.fold}/{w.celltype}/interpret_profile/{w.celltype}",
        script="./setup_environment.sh"
    shell:
        """
        mkdir -p {output.folder};
        {params.script} chrombpnet contribs_bw \
        -m {params.no_bias_model} \
        -r {input.peak} \
        -pc profile \
        -g {input.genome} \
        -c {input.chromsize} \
        -op {params.out_prefix};
        touch {output.success}
        """
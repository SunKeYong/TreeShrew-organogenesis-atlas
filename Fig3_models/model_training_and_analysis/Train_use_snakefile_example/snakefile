    localrule: True
    input:
        ## preparing inputs only
        #expand("data/nonpeaks/fold_{fold}/{celltype}_negatives.bed",celltype=config["CELLTYPE"],fold=config['FOLD'].keys()),
        ## training bias model only
        #expand("output/model_bias/fold_{fold}/" + config["CELLTYPE"] + "_{condition}_thresh{thresh}/", fold="0", condition=config["BIAS_CONDITION"], thresh=config["BIAS_THRESH"]),       
        ## training chrombpnet model
        expand("output/models/fold_{fold}/{celltype}/models",celltype=config["CELLTYPE"], fold=config['FOLD'].keys()),
        ## interpret 
        expand("output/models/fold_{fold}/{celltype}/interpret_counts/", celltype=config["CELLTYPE"], fold=config['FOLD'].keys()),
        expand("output/models/fold_{fold}/{celltype}/interpret_profile/", celltype=config["CELLTYPE"], fold=config['FOLD'].keys())

